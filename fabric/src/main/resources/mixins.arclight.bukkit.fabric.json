{
  "required": true,
  "minVersion": "0.8",
  "package": "org.craftamethyst.luminara.common.mixin.bukkit",
  "target": "@env(DEFAULT)",
  "refmap": "luminara.refmap.json",
  "setSourceFile": true,
  "plugin": "org.craftamethyst.luminara.common.mod.ArclightMixinPlugin",
  "injectors": {
    "defaultRequire": 1
  },
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "CraftMagicNumbersMixin",
    "EntityTypeMixin",
    "MaterialMixin",
    "Registry_SimpleRegistryMixin",
    "enumvalues.EntityTypeEnumMixin",
    "enumvalues.MaterialEnumMixin",
    "ColouredConsoleSenderMixin",
    "CraftConsoleCommandSenderMixin",
    "CraftServerMixin"
  ]
}
