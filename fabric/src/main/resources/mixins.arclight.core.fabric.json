{
  "required": true,
  "minVersion": "0.8",
  "package": "org.craftamethyst.luminara.common.mixin.core",
  "target": "@env(DEFAULT)",
  "setSourceFile": true,
  "injectors": {
    "maxShiftBy": 2,
    "defaultRequire": 1
  },
  "overwrites": {
    "conformVisibility": true
  },
  "mixinPriority": 500,
  "compatibilityLevel": "JAVA_17",
  "mixins": [
    "server.MinecraftServerMixin",
    "server.dedicated.DedicatedServerMixin",
    "server.management.PlayerListMixin",
    "server.WorldLoaderMixin",
    "server.level.TicketTypeMixin",
    "world.level.LevelMixin",
    "server.level.ServerLevelMixin",
    "world.level.border.WorldBorderMixin",
    "world.storage.LevelStorageSource_LevelStorageAccessMixin",
    "world.storage.LevelStorageSourceMixin",
    "world.storage.PlayerDataMixin",
    "world.storage.PrimaryLevelDataMixin",
    "world.storage.DerivedWorldInfoMixin",
    "server.level.ServerChunkCacheMixin",
    "server.level.ChunkMapMixin",
    "server.level.ChunkHolderMixin",
    "world.level.chunk.LevelChunkMixin",
    "world.level.chunk.ChunkAccessMixin",
    "world.level.chunk.LevelChunkSectionMixin"
  ],
  "plugin": "org.craftamethyst.luminara.common.mod.ArclightMixinPlugin"
}
